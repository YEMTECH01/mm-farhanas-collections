generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // 👈 MUST BE DATABASE_URL
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  image    String
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  image       String
  sizes       String   
  colors      String   
  isNew       Boolean  @default(false)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
}

model Order {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String
  city      String
  total     Float
  items     String   
  status    String   @default("Pending")
  createdAt DateTime @default(now())
}